{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run lint --silent >&2 || exit 2",
            "timeout": 60,
            "statusMessage": "Linting before commit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run lint --silent >&2 || exit 2",
            "timeout": 60,
            "statusMessage": "Linting"
          }
        ]
      }
    ]
  }
}
