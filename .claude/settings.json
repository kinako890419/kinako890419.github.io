{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/runs-git.mjs\" commit || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && npm run lint --silent >&2 || exit 2",
            "timeout": 60,
            "statusMessage": "Linting before commit"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-git.mjs\" commit",
            "timeout": 30,
            "statusMessage": "Summarizing commit"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-git.mjs\" push",
            "timeout": 30,
            "statusMessage": "Summarizing push"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/report-actions.mjs\"",
            "timeout": 40,
            "statusMessage": "Finding the GitHub Actions run"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run lint --silent >&2 || exit 2",
            "timeout": 60,
            "statusMessage": "Linting"
          }
        ]
      }
    ]
  }
}
