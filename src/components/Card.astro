---
import PixelIcon from './PixelIcon.astro';
import { profile, type CardFace } from '../data/profile';
import sprites from '../data/sprites.generated.json';
import { getStatusSprite, EMOJI_SIZE } from '../lib/github-status';
import { localize, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { card } = profile;

type Side = 'front' | 'back';
const faces: { side: Side; data: CardFace }[] = [
  { side: 'front', data: card.front },
  { side: 'back', data: card.back },
];

// Inside of the speech bubble in frame 0 (card pixels), where the emoji goes.
const BUBBLE = { x: 13, y: 15 };
const status = card.status ? await getStatusSprite(card.status.github, card.status.fallback) : null;
const statusTitle = status ? ['GitHub', status.message].filter(Boolean).join(': ') : undefined;

const animCss = faces
  .map(({ side }) => {
    const s = sprites[side];
    const total = s.delays.reduce((a, b) => a + b, 0);
    let t = 0;
    const artSteps: string[] = [];
    const bobSteps: string[] = [];
    s.delays.forEach((d, i) => {
      const at = ((t / total) * 100).toFixed(4);
      artSteps.push(`${at}% { transform: translateY(${(-100 * i) / s.frames}%); }`);
      bobSteps.push(`${at}% { transform: translateY(calc(var(--u) * ${s.bubbleOffsets[i]})); }`);
      t += d;
    });
    return `
      @keyframes card-art-${side} { ${artSteps.join(' ')} }
      @keyframes card-bob-${side} { ${bobSteps.join(' ')} }
      .face--${side} .face__art img { height: ${s.frames * 100}%; animation: card-art-${side} ${total}ms step-end infinite; }
      .face--${side} .face__status { animation: card-bob-${side} ${total}ms step-end infinite; }`;
  })
  .join('\n');

const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<div class="card-scene" data-card data-holo={card.holo}>
  <div class="card-tilt">
    <div class="card-inner">
      {faces.map(({ side, data }) => (
        <section
          class={`face face--${side}`}
          data-face={side}
          aria-label={t(side === 'front' ? 'card.front' : 'card.back')}
          inert={side === 'back'}
        >
          <div class="face__art">
            <img src={sprites[side].sheet} alt="" draggable="false" />
          </div>
          {status && (
            <img
              class="face__status"
              src={status.src}
              alt=""
              title={statusTitle}
              width={EMOJI_SIZE}
              height={EMOJI_SIZE}
              draggable="false"
              style={`left: calc(var(--u) * ${BUBBLE.x}); top: calc(var(--u) * ${BUBBLE.y}); width: calc(var(--u) * ${EMOJI_SIZE}); height: calc(var(--u) * ${EMOJI_SIZE});`}
            />
          )}
          <ul class="face__links pixel">
            {data.links.map((link) => (
              <li>
                <a href={localePath(link.url, lang)} rel={isExternal(link.url) ? 'me noopener' : undefined}>
                  {localize(link.label, lang)}
                </a>
              </li>
            ))}
          </ul>
          <button
            class="face__flip"
            type="button"
            data-card-flip
            aria-label={t(side === 'front' ? 'card.flip' : 'card.flipBack')}
            title={t(side === 'front' ? 'card.flip' : 'card.flipBack')}
          >
            <PixelIcon name="flipSmall" size="calc(var(--u) * 5)" />
          </button>
          <canvas class="face__holo" width="128" height="72" aria-hidden="true" />
        </section>
      ))}
    </div>
  </div>
</div>

<style is:inline set:html={animCss}></style>

<style>
  .card-scene {
    /* defaults for no-JS; card.ts refines these */
    --u: min(2px, calc((100vw - 2rem) / 128));
    --fs-link: 24px;
    --rx: 0deg;
    --ry: 0deg;
    --flip-ms: 600ms;

    position: relative;
    width: calc(var(--u) * 128);
    height: calc(var(--u) * 72);
    perspective: calc(var(--u) * 420);
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .card-tilt,
  .card-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .card-tilt {
    transform: rotateX(var(--rx)) rotateY(var(--ry));
  }

  .card-inner {
    /* stepped flip = low-framerate, sprite-like motion */
    transition: transform var(--flip-ms) steps(12, end);
  }

  .card-scene[data-dragging],
  .card-scene[data-dragging] * {
    cursor: grabbing;
  }

  .card-scene[data-flipped] .card-inner {
    transform: rotateY(180deg);
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    isolation: isolate;
    --ink: var(--cocoa);
    --link: #b14d66;
    --soft: var(--pink);
    --pale: var(--pink-pale);
  }

  .face--back {
    transform: rotateY(180deg);
    --link: #6553ad;
    --soft: var(--lilac);
    --pale: var(--lilac-pale);
  }

  .face__art {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .face__art img {
    display: block;
    width: 100%;
    image-rendering: pixelated;
  }

  .face__status {
    position: absolute;
    object-fit: contain; /* the real emoji, smoothly scaled (not pixelated) */
  }

  .face__holo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .face__holo {
    pointer-events: none;
  }

  /* links: vertically centred on the card, in the right-hand area */
  .face__links {
    position: absolute;
    left: calc(var(--u) * 78);
    top: calc(var(--u) * 6);
    width: calc(var(--u) * 42);
    height: calc(var(--u) * 60);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--u) * 1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-link);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .face__links a {
    display: inline-block;
    color: var(--link);
    text-decoration: none;
    cursor: pointer;
  }

  /* RPG-menu cursor, hangs in the left gutter */
  .face__links a::before {
    content: '▸';
    display: inline-block;
    width: 1.1em;
    margin-left: -1.1em;
    visibility: hidden;
  }

  .face__links a:is(:hover, :focus-visible)::before {
    visibility: visible;
  }

  .face__links a:is(:hover, :focus-visible) {
    background: var(--pale);
  }

  @media (hover: none) {
    .face__links a::before {
      visibility: visible;
    }
  }

  /* flip button: bottom-right corner, notched pixel border in sprite units */
  .face__flip {
    position: absolute;
    right: calc(var(--u) * 7);
    bottom: calc(var(--u) * 7);
    display: grid;
    place-items: center;
    width: calc(var(--u) * 7);
    height: calc(var(--u) * 7);
    padding: 0;
    border: 0;
    color: var(--soft); /* same colour as the button border */
    background: var(--cream);
    cursor: pointer;
    box-shadow:
      0 calc(var(--u) * -1) 0 0 var(--soft),
      0 var(--u) 0 0 var(--soft),
      calc(var(--u) * -1) 0 0 0 var(--soft),
      var(--u) 0 0 0 var(--soft);
  }

  .face__flip:hover {
    background: var(--pale);
  }

  .face__flip:active {
    transform: translateY(var(--u));
  }

  .face :focus-visible {
    outline: var(--u) solid var(--link);
    outline-offset: var(--u);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-inner {
      transition: none;
    }
  }
</style>

<script>
  import { initCard } from '../scripts/card';
  document.querySelectorAll<HTMLElement>('[data-card]').forEach(initCard);
</script>
