---
import { formatDate, localePath, useTranslations, type Lang } from '../i18n/ui';
import { yearOf, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  lang: Lang;
  /** show a heading for each year (posts must be sorted newest first) */
  groupByYear?: boolean;
}
const { posts, lang, groupByYear = true } = Astro.props;
const t = useTranslations(lang);

const groups: { year: string | null; posts: Post[] }[] = [];
for (const post of posts) {
  const year = groupByYear ? yearOf(post) : null;
  const last = groups.at(-1);
  if (last && last.year === year) last.posts.push(post);
  else groups.push({ year, posts: [post] });
}
---

{posts.length === 0 ? (
  <p class="empty pixel">{t('blog.empty')}</p>
) : (
  groups.map((group) => (
    <section class="year-group">
      {group.year && <h2 class="year pixel">{group.year}</h2>}
      <ul class="post-list">
        {group.posts.map((post) => (
          <li>
            <a class="post-link" href={localePath(`/blog/${post.slug}/`, lang)}>
              <time class="pixel" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date, lang)}
              </time>
              <span class="post-title pixel">
                {post.data.title}
                {post.data.draft && <span class="draft">DRAFT</span>}
              </span>
              {post.data.description && <span class="post-desc">{post.data.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
)}

<style>
  .year-group + .year-group {
    margin-top: 1rem;
  }
  .year {
    margin: 0.25rem 0 0.25rem 0.9rem;
    font-size: 0.9375rem;
    font-weight: normal;
    color: var(--accent);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .post-link {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    column-gap: 1rem;
    padding: 0.7rem 0.9rem 0.7rem 1.8rem;
    position: relative;
    color: var(--text);
    text-decoration: none;
  }
  /* RPG-menu cursor */
  .post-link::before {
    content: '▸';
    position: absolute;
    left: 0.5rem;
    top: 0.7rem;
    font-family: var(--font-pixel);
    color: var(--accent);
    visibility: hidden;
  }
  .post-link:is(:hover, :focus-visible) {
    background: var(--accent-pale);
  }
  .post-link:is(:hover, :focus-visible)::before {
    visibility: visible;
  }
  time {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-top: 0.15em;
  }
  .post-title {
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .post-desc {
    grid-column: 2;
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .draft {
    margin-left: 0.5em;
    padding: 0 0.4em;
    font-size: 0.75rem;
    background: var(--accent-soft);
    color: var(--text);
  }
  .empty {
    color: var(--text-muted);
  }
  @media (max-width: 520px) {
    .post-link {
      grid-template-columns: 1fr;
    }
    .post-desc {
      grid-column: 1;
    }
  }
</style>
